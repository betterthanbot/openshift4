      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "group by (model_name, namespace) (vllm:num_requests_running{namespace=~\"$namespace\", model_name=~\"$model_name\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (model_name, namespace) (increase(vllm:request_success_total{namespace=~\"$namespace\", model_name=~\"$model_name\"}[$__range])) or (0 * group by (model_name, namespace)(vllm:num_requests_running{namespace=~\"$namespace\", model_name=~\"$model_name\"}))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "avg_over_time((histogram_quantile(0.90, sum by (le, model_name, namespace) (rate(vllm:e2e_request_latency_seconds_bucket{namespace=~\"$namespace\", model_name=~\"$model_name\"}[5m]))) > -Inf)[$__range:5m]) or (0 * group by (model_name, namespace)(vllm:num_requests_running{namespace=~\"$namespace\", model_name=~\"$model_name\"}))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum by (model_name, namespace)(increase(vllm:request_success_total{namespace=~\"$namespace\", finished_reason=~\"error|abort\", model_name=~\"$model_name\"}[$__range])) / (sum by (model_name, namespace)(increase(vllm:request_success_total{namespace=~\"$namespace\", model_name=~\"$model_name\"}[$__range])) > 0)) or (0 * group by (model_name, namespace)(vllm:num_requests_running{namespace=~\"$namespace\", model_name=~\"$model_name\"}))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "avg_over_time((sum by (model_name, namespace) (DCGM_FI_DEV_GPU_UTIL{namespace=~\"$namespace\"} * on(namespace, pod) group_left(model_name) (0 * max by (namespace, pod, model_name)(vllm:num_requests_running{namespace=~\"$namespace\", model_name=~\"$model_name\"}) + 1)))[$__range:5m]) or (0 * group by (model_name, namespace)(vllm:num_requests_running{namespace=~\"$namespace\", model_name=~\"$model_name\"}))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "avg_over_time((sum by (model_name, namespace) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", container!=\"\", container!=\"POD\"}[5m]) * on(namespace, pod) group_left(model_name) (0 * group by (model_name, namespace, pod)(vllm:num_requests_running{namespace=~\"$namespace\", model_name=~\"$model_name\"}) + 1)) / scalar(sum(kube_node_status_allocatable{resource=\"cpu\"})) * 100)[$__range:5m]) or (0 * group by (model_name, namespace)(vllm:num_requests_running{namespace=~\"$namespace\", model_name=~\"$model_name\"}))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "F"
        }
      ],
      "title": "Model Deployments",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "active",
              "Value #B": "requests (range)",
              "Value #C": "p90 latency (s)",
              "Value #D": "error rate",
              "Value #E": "gpu util %",
              "Value #F": "cpu util % (cluster)",
              "model_name": "model",
              "namespace": "namespace"
            }
          }
        }
      ],
      "type": "table",
      "description": "One row per (model, namespace). 'active' is a presence signal (vllm:num_requests_running exists for that model), not a live request count.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
