      },
      "pluginVersion": "12.3.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "editorMode": "builder",
          "expr": "sum by (code) (rate(http_requests_total[1m])) or sum by (status) (rate(nginx_ingress_controller_requests[1m]))",
